/* =========================================================
   RECOVERAI 3D CYBER GLOBE INTRO
   Royal Green + Cyber Blue
   ========================================================= */

.recoverai-intro {
  --intro-blue: #2563eb;
  --intro-cyan: #06b6d4;
  --intro-green: #047857;
  --intro-emerald: #10b981;
  --intro-navy: #0f172a;
  --intro-bg: #f4faf8;

  min-height: 100vh;
  background:
    radial-gradient(
      circle at 50% 45%,
      rgba(37, 99, 235, 0.08),
      transparent 34%
    ),
    radial-gradient(
      circle at 30% 70%,
      rgba(16, 185, 129, 0.08),
      transparent 32%
    ),
    var(--intro-bg);

  color: var(--intro-navy);
  overflow-x: hidden;
}

/* ---------------------------------------------------------
   SCROLL SPACE
--------------------------------------------------------- */

.intro-scroll-space {
  height: 360vh;
  position: relative;
}

.intro-sticky {
  position: sticky;
  top: 0;

  width: 100%;
  height: 100vh;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 50% 46%,
      rgba(6, 182, 212, 0.09),
      transparent 28%
    ),
    linear-gradient(
      135deg,
      #f8fcfb 0%,
      #f2f8ff 52%,
      #effaf6 100%
    );
}

/* ---------------------------------------------------------
   3D CANVAS
--------------------------------------------------------- */

.intro-canvas {
  position: absolute;
  inset: 0;

  z-index: 1;
}

.intro-canvas canvas {
  width: 100% !important;
  height: 100% !important;
}

/* ---------------------------------------------------------
   BRAND
--------------------------------------------------------- */

.intro-brand {
  position: absolute;

  top: 32px;
  left: 42px;

  z-index: 10;

  display: flex;
  align-items: center;
  gap: 11px;
}

.intro-brand-mark {
  width: 40px;
  height: 40px;

  display: grid;
  place-items: center;

  color: white;

  background:
    linear-gradient(
      135deg,
      var(--intro-blue),
      var(--intro-green)
    );

  border-radius: 11px;

  box-shadow:
    0 10px 30px
      rgba(37, 99, 235, 0.18),
    0 8px 20px
      rgba(4, 120, 87, 0.12);
}

.intro-brand strong {
  display: block;

  font-size: 15px;
  font-weight: 850;

  letter-spacing: 0.16em;

  color: var(--intro-navy);
}

.intro-brand span {
  display: block;

  margin-top: 3px;

  font-size: 8px;

  letter-spacing: 0.18em;

  color: #64748b;
}

/* ---------------------------------------------------------
   INTRO COPY
--------------------------------------------------------- */

.intro-copy {
  position: absolute;

  left: 8%;
  top: 50%;

  z-index: 5;

  width: 430px;

  transform:
    translateY(-50%);

  transition:
    opacity 0.45s ease,
    transform 0.55s ease;
}

.intro-copy-hidden {
  opacity: 0;

  transform:
    translateY(-60px);
}

.intro-eyebrow {
  display: inline-flex;

  align-items: center;

  padding: 7px 10px;

  border-radius: 20px;

  background:
    rgba(37, 99, 235, 0.07);

  border:
    1px solid
    rgba(37, 99, 235, 0.14);

  color: var(--intro-blue);

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 0.13em;
}

.intro-copy h1 {
  margin: 22px 0 16px;

  font-size: clamp(
    48px,
    5.3vw,
    78px
  );

  line-height: 0.98;

  letter-spacing: -0.055em;

  font-weight: 850;

  color: var(--intro-navy);
}

.intro-copy h1 span {
  background:
    linear-gradient(
      100deg,
      var(--intro-blue),
      var(--intro-cyan),
      var(--intro-green)
    );

  -webkit-background-clip: text;
  background-clip: text;

  color: transparent;
}

.intro-copy p {
  max-width: 410px;

  margin: 0;

  color: #52657b;

  font-size: 14px;

  line-height: 1.75;
}

/* ---------------------------------------------------------
   SCROLL INDICATOR
--------------------------------------------------------- */

.intro-scroll {
  position: absolute;

  bottom: 34px;
  left: 50%;

  z-index: 10;

  display: flex;
  flex-direction: column;

  align-items: center;

  gap: 5px;

  transform:
    translateX(-50%);

  color: #64748b;

  font-size: 8px;

  font-weight: 800;

  letter-spacing: 0.18em;

  transition:
    opacity 0.4s ease,
    transform 0.4s ease;
}

.intro-scroll svg {
  color: var(--intro-blue);

  animation:
    intro-bounce 1.5s
    ease-in-out infinite;
}

.intro-scroll-hidden {
  opacity: 0;

  transform:
    translate(-50%, 20px);
}

@keyframes intro-bounce {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(7px);
  }
}

/* ---------------------------------------------------------
   NAVIGATION HINT
--------------------------------------------------------- */

.globe-nav-hint {
  position: absolute;

  bottom: 34px;
  right: 48px;

  z-index: 10;

  display: flex;
  align-items: center;
  gap: 9px;

  color: #64748b;

  font-size: 8px;

  font-weight: 800;

  letter-spacing: 0.14em;
}

.globe-nav-line {
  width: 32px;
  height: 1px;

  background:
    linear-gradient(
      90deg,
      var(--intro-blue),
      var(--intro-green)
    );
}

/* ---------------------------------------------------------
   ENTER BUTTON
--------------------------------------------------------- */

.intro-enter {
  position: absolute;

  right: 45px;
  top: 32px;

  z-index: 20;

  padding: 11px 16px;

  border: 1px solid
    rgba(37, 99, 235, 0.25);

  border-radius: 8px;

  background: white;

  color: var(--intro-blue);

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 0.08em;

  box-shadow:
    0 10px 30px
      rgba(15, 23, 42, 0.07);

  cursor: pointer;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.intro-enter:hover {
  transform:
    translateY(-2px);

  background:
    linear-gradient(
      135deg,
      #ffffff,
      #f0faf7
    );

  box-shadow:
    0 15px 35px
      rgba(37, 99, 235, 0.14);
}

/* ---------------------------------------------------------
   TRANSITION PANEL
--------------------------------------------------------- */

.intro-transition-panel {
  min-height: 100vh;

  display: grid;
  place-items: center;

  padding: 80px 30px;

  text-align: center;

  background:
    linear-gradient(
      135deg,
      #f4faf8,
      #f1f6ff
    );

  opacity: 0;

  transform:
    translateY(40px);

  transition:
    opacity 0.8s ease,
    transform 0.8s ease;
}

.intro-transition-panel.visible {
  opacity: 1;

  transform:
    translateY(0);
}

.intro-transition-panel > div {
  max-width: 700px;
}

.intro-transition-panel span {
  color: var(--intro-green);

  font-size: 10px;

  font-weight: 850;

  letter-spacing: 0.18em;
}

.intro-transition-panel h2 {
  margin: 15px 0;

  color: var(--intro-navy);

  font-size: clamp(
    38px,
    5vw,
    64px
  );

  line-height: 1;

  letter-spacing: -0.05em;
}

.intro-transition-panel p {
  color: #64748b;

  font-size: 14px;
}

.intro-primary {
  margin-top: 22px;

  padding: 13px 20px;

  border: 0;

  border-radius: 8px;

  background:
    linear-gradient(
      100deg,
      var(--intro-blue),
      var(--intro-green)
    );

  color: white;

  font-size: 11px;

  font-weight: 800;

  letter-spacing: 0.04em;

  box-shadow:
    0 12px 30px
      rgba(37, 99, 235, 0.18);

  cursor: pointer;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.intro-primary:hover {
  transform:
    translateY(-2px);

  box-shadow:
    0 18px 40px
      rgba(4, 120, 87, 0.18);
}

/* ---------------------------------------------------------
   RESPONSIVE
--------------------------------------------------------- */

@media (max-width: 900px) {
  .intro-copy {
    left: 5%;
    width: 330px;
  }

  .intro-copy h1 {
    font-size: 48px;
  }

  .intro-brand {
    left: 22px;
    top: 22px;
  }

  .intro-enter {
    right: 22px;
    top: 22px;
  }
}