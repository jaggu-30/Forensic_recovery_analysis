import React, {
  useEffect,
  useState,
} from "react";

import { Canvas } from "@react-three/fiber";
import {
  OrbitControls,
} from "@react-three/drei";

import {
  useNavigate,
} from "react-router-dom";

import CyberGlobe from "../components/intro/CyberGlobe";
import GlobeFragments from "../components/intro/GlobeFragments";
import IntroOverlay from "../components/intro/IntroOverlay";

export default function Home() {
  const navigate =
    useNavigate();

  const [progress, setProgress] =
    useState(0);

  useEffect(() => {
    const handleScroll = () => {
      const maxScroll =
        document.documentElement
          .scrollHeight -
        window.innerHeight;

      if (maxScroll <= 0) {
        setProgress(0);
        return;
      }

      const value =
        window.scrollY / maxScroll;

      setProgress(
        Math.max(
          0,
          Math.min(value, 1)
        )
      );
    };

    window.addEventListener(
      "scroll",
      handleScroll,
      { passive: true }
    );

    handleScroll();

    return () =>
      window.removeEventListener(
        "scroll",
        handleScroll
      );
  }, []);

  return (
    <div className="recoverai-intro">

      {/* ------------------------------------------------
          SCROLL SPACE
      ------------------------------------------------ */}

      <div className="intro-scroll-space">

        <div className="intro-sticky">

          {/* 3D WORLD */}
          <div className="intro-canvas">
            <Canvas
              camera={{
                position: [
                  0,
                  0,
                  6.5,
                ],
                fov: 42,
              }}
              dpr={[1, 2]}
              gl={{
                antialias: true,
                alpha: true,
              }}
            >
              <color
                attach="background"
                args={[
                  "#F4FAF8",
                ]}
              />

              <ambientLight
                intensity={0.8}
              />

              <directionalLight
                position={[
                  4,
                  5,
                  6,
                ]}
                intensity={2.5}
                color="#FFFFFF"
              />

              <CyberGlobe
                progress={progress}
              />

              <GlobeFragments
                progress={progress}
              />

              <OrbitControls
                enablePan={false}
                enableZoom={false}
                enableRotate={
                  progress < 0.22
                }
                autoRotate
                autoRotateSpeed={0.25}
              />
            </Canvas>
          </div>

          {/* UI OVERLAY */}
          <IntroOverlay
            progress={progress}
            onStart={() =>
              navigate(
                "/investigation/new"
              )
            }
          />

        </div>
      </div>

      {/* ------------------------------------------------
          INTRO END / PLATFORM ENTRY
      ------------------------------------------------ */}

      <section
        className={`intro-transition-panel ${
          progress > 0.88
            ? "visible"
            : ""
        }`}
      >
        <div>
          <span>
            RECOVERAI
          </span>

          <h2>
            Intelligent Digital
            <br />
            Evidence Reconstruction
          </h2>

          <p>
            Recover. Reconstruct.
            Verify. Understand.
          </p>

          <button
            className="intro-primary"
            onClick={() =>
              navigate(
                "/investigation/new"
              )
            }
          >
            Start Investigation
          </button>
        </div>
      </section>

    </div>
  );
}